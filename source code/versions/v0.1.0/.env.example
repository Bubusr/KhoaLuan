# ==========================================
# CONFIGURATION ENVIRONMENT VARIABLES
# ==========================================

# 1. Môi trường chạy (development, production)
ENV=development

# 2. API Keys cho LLMs (Dùng cho Parser, Generator và Evaluators)
# Bạn chỉ cần cung cấp API của model bạn muốn sử dụng.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Cấu hình Langfuse (Dùng cho Tracing và Lưu trữ Scores)
# Lấy các thông số này từ phần Settings > API Keys trên Langfuse Cloud
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# 4. Cấu hình Vector Database & Mô hình nhúng (Tuỳ chọn)
# Mặc định sử dụng: neuml/pubmedbert-base-embeddings
# EMBEDDING_MODEL=neuml/pubmedbert-base-embeddings
